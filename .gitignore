# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

#Other C++ compilation files
*.exp
*.pdb


# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
UE/aKMcontrol/SourceArt/**/*.png
UE/aKMcontrol/SourceArt/**/*.tga

# Binary Files
UE/aKMcontrol/Binaries/*
UE/aKMcontrol/Plugins/**/Binaries/*

# Builds
UE/aKMcontrol/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
UE/aKMcontrol/!Build/*/
UE/aKMcontrol/Build/*/**
UE/aKMcontrol/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
UE/aKMcontrol/!Build/**/*.ico

# Built data for maps
UE/aKMcontrol/*_BuiltData.uasset

# Configuration files generated by the Editor
UE/aKMcontrol/Saved/*

# Compiled source files for the engine to use
UE/aKMcontrol/Intermediate/*
UE/aKMcontrol/Plugins/**/Intermediate/*

# Cache files for the editor to use
UE/aKMcontrol/DerivedDataCache/*
